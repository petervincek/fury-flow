{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/boards": {
            "get": {
                "description": "Retrieves a list of all Kanban boards for the current user/context.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "boards"
                ],
                "summary": "Get all Kanban boards",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/board.Board"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/common.ErrorMsg"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "board.Board": {
            "type": "object",
            "required": [
                "boardName",
                "description"
            ],
            "properties": {
                "boardId": {
                    "type": "integer"
                },
                "boardName": {
                    "type": "string",
                    "minLength": 3
                },
                "createdAt": {
                    "type": "string"
                },
                "createdBy": {
                    "type": "string"
                },
                "description": {
                    "type": "string",
                    "minLength": 3
                },
                "updatedAt": {
                    "type": "string"
                },
                "updatedBy": {
                    "type": "string"
                }
            }
        },
        "common.ErrorMsg": {
            "type": "object",
            "properties": {
                "errors": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "message": {
                    "type": "string"
                }
            }
        }
    }
}