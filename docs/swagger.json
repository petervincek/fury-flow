    "definitions": {
        "board.Board": {
            "type": "object",
            "required": [
                "boardName",
                "description"
            ],
            "properties": {
                "boardId": {
                    "type": "integer"
                },
                "boardName": {
                    "type": "string",
                    "minLength": 3
                },
                "createdAt": {
                    "type": "string"
                },
                "createdBy": {
                    "type": "string"
                },
                "description": {
                    "type": "string",
                    "minLength": 3
                },
                "updatedAt": {
                    "type": "string"
                },
                "updatedBy": {
                    "type": "string"
                }
            }
        },
        "card.Card": {
            "type": "object",
            "required": [
                "acceptanceCriteria",
                "description",
                "status",
                "storyPoints",
                "title",
                "type"
            ],
            "properties": {
                "acceptanceCriteria": {
                    "type": "string",
                    "minLength": 3
                },
                "assignee": {
                    "type": "string"
                },
                "blockedReason": {
                    "type": "string"
                },
                "boardId": {
                    "description": "should this be at this level just id or the whole board document",
                    "type": "integer"
                },
                "cardId": {
                    "type": "integer"
                },
                "createdAt": {
                    "type": "string"
                },
                "createdBy": {
                    "type": "string"
                },
                "description": {
                    "type": "string",
                    "minLength": 3
                },
                "isBlocked": {
                    "type": "boolean"
                },
                "priority": {
                    "$ref": "#/definitions/card.Priority"
                },
                "status": {
                    "minLength": 3,
                    "allOf": [
                        {
                            "$ref": "#/definitions/card.Status"
                        }
                    ]
                },
                "storyPoints": {
                    "type": "integer"
                },
                "timeSpentHours": {
                    "type": "number"
                },
                "title": {
                    "type": "string",
                    "minLength": 3
                },
                "type": {
                    "minLength": 3,
                    "allOf": [
                        {
                            "$ref": "#/definitions/card.Type"
                        }
                    ]
                },
                "updatedAt": {
                    "type": "string"
                },
                "updatedBy": {
                    "type": "string"
                }
            }
        },
        "card.Priority": {
            "type": "string",
            "enum": [
                "High",
                "Medium",
                "Low"
            ],
            "x-enum-varnames": [
                "PriorityHigh",
                "PriorityMedium",
                "PriorityLow"
            ]
        },
        "card.Status": {
            "type": "string",
            "enum": [
                "To Do",
                "In Progress",
                "In Review",
                "Done"
            ],
            "x-enum-varnames": [
                "StatusTodo",
                "StatusInProgress",
                "StatusInReview",
                "StatusDone"
            ]
        },
        "card.Type": {
            "type": "string",
            "enum": [
                "Bug",
                "Feature",
                "Maintenance"
            ],
            "x-enum-varnames": [
                "TypeBug",
                "TypeFeature",
                "TypeMaintenance"
            ]
        },
        "common.ErrorMsg": {
            "type": "object",
            "properties": {
                "errors": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "message": {
                    "type": "string"
                }
            }
        }
    }
